# Server
PORT=4000
NODE_ENV=development

# Comma-separated list of allowed CORS origins (NO trailing slash on any of them)
CORS_ORIGIN=http://localhost:5173,https://bassera-agency.vercel.app

# PostgreSQL. Prisma reads DATABASE_URL; the split DB_* vars are for scripts / psql.
DB_USER=user
DB_HOST=host
DB_NAME=database
DB_PASSWORD=password
DB_PORT=5432
# Local dev against Render: use the External host and keep ?sslmode=require
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# --- Auth ---
JWT_ACCESS_SECRET=replace-with-32+-random-bytes
JWT_ACCESS_TTL=900
REFRESH_TOKEN_TTL=2592000
REFRESH_COOKIE_NAME=bassera_rt
BCRYPT_COST=12
BOOTSTRAP_ADMIN_EMAIL=you@bassera.agency

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
# REDIS_URL=redis://localhost:6379

# --- Media ---
MEDIA_DRIVER=local
MEDIA_MAX_BYTES=5242880
MEDIA_PUBLIC_BASE_URL=http://localhost:4000/uploads

# ImageKit (only read when MEDIA_DRIVER=imagekit). Only the private key is
# actually required server-side; get all three from imagekit.io → Developer options.
# IMAGEKIT_PUBLIC_KEY=public_xxx
# IMAGEKIT_PRIVATE_KEY=private_xxx
# IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id
